  "theme_color": "#3a2a6a",
  "categories": ["games", "entertainment"],
  "icons": [
    { "src": "/aviones-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/aviones-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/aviones-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/aviones-icono.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
