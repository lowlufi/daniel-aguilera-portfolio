{
  "name": "Escuadrón Dui",
  "short_name": "Escuadrón Dui",
  "description": "Juego de aviones en pixel art de Daniel Eduardo: Dui, Lulu y Almendrita contra los ratones y la vecina Margarita.",
  "lang": "es-CL",
  "id": "/aviones",
  "start_url": "/aviones?app=1",
