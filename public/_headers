/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' https://d8j0ntlcm91z4.cloudfront.net; connect-src 'self' https://api.open-meteo.com https://cloudflareinsights.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=2592000

# Game sounds keep their names between deploys: a week, revalidated in the background after that.
/sonidos/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# The Android app (built by `npm run android:apk`, copied into dist at deploy; not in git).
/escuadron-dui.apk
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment; filename="escuadron-dui.apk"
  Cache-Control: no-cache

/aviones-192.png
  Cache-Control: public, max-age=604800

/aviones-512.png
  Cache-Control: public, max-age=604800

/aviones-apple.png
  Cache-Control: public, max-age=604800

/aviones-icono.svg
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/og-image.svg
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800

/index.html
  Cache-Control: no-cache

# The build adds a Link preload header (sent as 103 Early Hints) under each landing route.
/
  Cache-Control: no-cache

/aviones
  Cache-Control: no-cache

/aviones-sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /aviones

/aviones.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
